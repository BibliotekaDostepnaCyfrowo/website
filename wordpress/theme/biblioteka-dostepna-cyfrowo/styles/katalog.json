				{
					"slug": "rule",
					"name": "Linia",
					"color": "#6f6c62"
				},
				{
					"slug": "rule-faint",
					"name": "Linia delikatna",
					"color": "#c9d3e3"
				},
				{
					"slug": "on-bookcloth",
					"name": "Tekst na płótnie",
					"color": "#f1ede2"
				}
			]
		},
