				{
					"slug": "small",
					"name": "Mały",
					"size": "0.9375rem"
				},
				{
					"slug": "medium",
					"name": "Normalny",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Duży",
					"size": "1.1875rem"
				},
				{
					"slug": "x-large",
					"name": "Bardzo duży",
					"size": "1.3125rem"
				},
				{
					"slug": "xx-large",
					"name": "Nagłówek",
					"size": "clamp(1.5rem, 1.1rem + 1.6vw, 1.75rem)"
				},
				{
					"slug": "huge",
					"name": "Tytuł",
					"size": "clamp(2.25rem, 1.6rem + 2.6vw, 3rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--gray-light)",
			"text": "var(--wp--preset--color--black)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--blue)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--blue)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--black)"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.08",
					"letterSpacing": "-0.01em",
					"fontSize": "var(--wp--preset--font-size--huge)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.3"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blue)",
					"text": "var(--wp--preset--color--on-stamp)"
				},
				"border": {
					"radius": "2px",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--blue)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1rem",
						"right": "1rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--typewriter)",
					"fontSize": "0.9375rem",
					"fontWeight": "700",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase",
					"textDecoration": "none",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--blue)",
						"text": "var(--wp--preset--color--on-stamp)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--blue)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "1.125rem",
					"fontWeight": "700"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--ink-muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--typewriter)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "400"
				}
			}
		}
	}
}